# ContributorAI API — copy to apps/api/.env (gitignored). Never commit real values.
NODE_ENV=development
PORT=3000

# PostgreSQL running on the Docker host (see infra/docker-compose.yml).
DATABASE_URL=postgres://ca:CHANGE_ME@192.168.0.62:5432/contributor_ai
TEST_DATABASE_URL=postgres://ca:CHANGE_ME@192.168.0.62:5432/contributor_ai_test

# Redis is optional; the app falls back to in-memory stores when unset.
# REDIS_URL=redis://192.168.0.62:6379

# Web origins allowed to call the API with credentials (comma separated).
CORS_ORIGINS=http://localhost:5173

# Cookies: false for local http dev, true behind HTTPS in production.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=ca_session

# AI provider (first used in Phase 4; Phase 1-3 only runs health checks).
# Providers: openrouter | openai | anthropic | ollama
AI_PROVIDER=openrouter
AI_MODEL=google/gemini-3.1-flash-lite
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_MS=60000
# OPENROUTER_API_KEY=       # server-side only — never expose to the browser
# OPENAI_API_KEY=           # dipakai saat AI_PROVIDER=openai
# ANTHROPIC_API_KEY=        # dipakai saat AI_PROVIDER=anthropic
# OLLAMA_BASE_URL=http://192.168.0.62:11434/v1  # dipakai saat AI_PROVIDER=ollama

# Pencarian web (Tavily, Firecrawl, Brave Search). Penyedia tanpa key dilewati.
# Urutan prioritas diatur admin di menu Provider AI, bukan di berkas ini.
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=
# BRAVE_SEARCH_API_KEY=
WEB_SEARCH_MAX_ATTEMPTS=3
WEB_SEARCH_TIMEOUT_MS=15000
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_CALLS_PER_TURN=5

# Bootstrap admin (dipakai oleh `npm run create-admin`).
# ADMIN_EMAIL=admin@contoh.co.id
# ADMIN_PASSWORD=minimal-10-karakter
# ADMIN_NAME=Super Admin

# Kunci enkripsi token OAuth MCP (base64, 32 byte): openssl rand -base64 32
# Guardrails: kunci token dan enkripsi kamus (32 byte base64: openssl rand -base64 32).
# Tanpa kunci, Guardrails tidak bisa diaktifkan. Mengganti kunci membuat token lama tidak berlaku.
# GUARDRAILS_SECRET_KEY=

# INTEGRATIONS_ENCRYPTION_KEY=

LOG_LEVEL=info
